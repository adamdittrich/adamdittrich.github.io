<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Compact Author-Date</title>
    <id>http://www.zotero.org/styles/compact-author-date-local</id>
    <link href="http://www.zotero.org/styles/compact-author-date-local" rel="self"/>
    <updated>2026-08-27T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author"><name and="text" initialize-with=". "/></names>
  </macro>
  <citation collapse="year">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", "><text macro="author"/><date variable="issued"><date-part name="year"/></date></group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="8" et-al-use-first="6">
    <sort><key macro="author"/><key variable="issued" sort="descending"/></sort>
    <layout suffix=".">
      <text macro="author" suffix=". "/>
      <date variable="issued" suffix=". "><date-part name="year"/></date>
      <text variable="title" font-style="italic" suffix=". "/>
      <text variable="container-title" suffix=" "/>
      <group delimiter=", "><text variable="volume"/><text variable="issue" prefix="(" suffix=")"/><text variable="page"/></group>
      <text variable="DOI" prefix=". https://doi.org/"/>
    </layout>
  </bibliography>
</style>
